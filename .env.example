# Copy to .env and fill in. Everything runs on the PayPal *sandbox*.

SI_ENV=development
SI_PUBLIC_BASE_URL=http://localhost:8000

# Leave as-is for a zero-setup local SQLite file, or point at Postgres:
#   postgresql://user:pass@host:5432/sayinvoice  (rewritten for asyncpg automatically)
SI_DATABASE_URL=sqlite+aiosqlite:///./sayinvoice.db

# developer.paypal.com → Apps & Credentials → (Sandbox) your app
SI_PAYPAL_ENV=sandbox
SI_PAYPAL_CLIENT_ID=
SI_PAYPAL_CLIENT_SECRET=
# The sandbox *Business* account email (Testing Tools → Sandbox Accounts)
SI_PAYPAL_MERCHANT_EMAIL=
# After adding a webhook for {SI_PUBLIC_BASE_URL}/api/webhooks/paypal
SI_PAYPAL_WEBHOOK_ID=
# Local runs use npx; the Docker image overrides this.
SI_PAYPAL_MCP_COMMAND=npx -y @paypal/mcp@1.8.1

# Gemini: an AI Studio key (aistudio.google.com/apikey) …
SI_GOOGLE_API_KEY=
# … or Vertex AI instead (leave the key empty)
SI_VERTEX_PROJECT=
SI_VERTEX_LOCATION=us-central1
SI_GEMINI_MODEL=gemini-3.1-flash
