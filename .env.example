# Copy to .env and fill in. Everything runs on the PayPal *sandbox*.

SI_ENV=development

# Owner sign-in. Empty = the app is open (fine on your laptop). Production refuses to
# start without it. Clients never need it: quote and plan links open on their own.
SI_OWNER_PASSCODE=
# Optional: signs the sign-in cookie (defaults to deriving from the PayPal secret).
SI_SESSION_SECRET=
SI_PUBLIC_BASE_URL=http://localhost:8000

# Leave as-is for a zero-setup local SQLite file, or point at Postgres:
#   postgresql://user:pass@host:5432/sayinvoice  (rewritten for asyncpg automatically)
SI_DATABASE_URL=sqlite+aiosqlite:///./data/sayinvoice.db

# developer.paypal.com → Apps & Credentials → (Sandbox) your app
SI_PAYPAL_ENV=sandbox
SI_PAYPAL_CLIENT_ID=
SI_PAYPAL_CLIENT_SECRET=
# The sandbox *Business* account email (Testing Tools → Sandbox Accounts)
SI_PAYPAL_MERCHANT_EMAIL=
# After adding a webhook for {SI_PUBLIC_BASE_URL}/api/webhooks/paypal
SI_PAYPAL_WEBHOOK_ID=
# Local runs use npx (needs Node 18+). In Docker the image's bundled copy is used
# automatically, whatever this says.
SI_PAYPAL_MCP_COMMAND=npx -y @paypal/mcp@1.8.1

# Gemini: an AI Studio key (aistudio.google.com/apikey) …
SI_GOOGLE_API_KEY=
# … or Vertex AI instead (leave the key empty)
SI_VERTEX_PROJECT=
SI_VERTEX_LOCATION=us-central1
SI_GEMINI_MODEL=gemini-3.5-flash
SI_GEMINI_THINKING_LEVEL=minimal

# Voice read-back: "browser" (the phone's own voice; default) or "kokoro"
# (KokoroTTS on the server: `uv sync --extra tts`, ~1 GB with PyTorch, model downloads on first use)
SI_TTS_ENGINE=browser
# Languages Kokoro preloads at startup, so the first read-back is quick (others load on first use).
SI_TTS_PRELOAD=en-GB,en-US
# Docker only: true builds the image with Kokoro inside (then `docker compose up --build`)
SI_INSTALL_TTS=false
